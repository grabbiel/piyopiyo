{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeliverOnlyPiyoPiyoStack",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:DescribeStacks",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:GetTemplate",
        "cloudformation:TagResource",
        "cloudformation:UntagResource"
      ],
      "Resource": [
        "arn:aws:cloudformation:us-east-1:992680757326:stack/PiyoPiyoDev/*",
        "arn:aws:cloudformation:us-east-1:992680757326:changeSet/ci-*/*"
      ]
    },
    {
      "Sid": "ReadDeploymentIdentity",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PublishAndReadBuildArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::piyopiyo-provenance/deploy/functions/*",
        "arn:aws:s3:::piyopiyo-provenance/deploy/templates/*"
      ]
    },
    {
      "Sid": "UpdateExistingAppFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:GetFunctionRecursionConfig",
        "lambda:GetFunctionScalingConfig",
        "lambda:GetRuntimeManagementConfig",
        "lambda:ListTags",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:992680757326:function:piyopiyo-dev-api",
        "arn:aws:lambda:us-east-1:992680757326:function:piyopiyo-knowledge-api",
        "arn:aws:lambda:us-east-1:992680757326:function:piyopiyo-knowledge-worker",
        "arn:aws:lambda:us-east-1:992680757326:function:piyopiyo-knowledge-pdf"
      ]
    },
    {
      "Sid": "PreserveExistingExecutionRoles",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::992680757326:role/PiyoPiyoDev-ApiExecution19218AAE-UiYjvIm2tZPQ",
        "arn:aws:iam::992680757326:role/PiyoPiyoDev-KnowledgeAPIRole4717F15A-gLS6qevDv0Yx",
        "arn:aws:iam::992680757326:role/PiyoPiyoDev-KnowledgeWorkerRole6EA081DE-WIIdqSVtjRrC",
        "arn:aws:iam::992680757326:role/PiyoPiyoDev-KnowledgePDFRole5CE8A860-5d5r40MlY28i"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadExistingExecutionRoles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:ListAttachedRolePolicies",
        "iam:ListRolePolicies",
        "iam:GetRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::992680757326:role/PiyoPiyoDev-ApiExecution19218AAE-UiYjvIm2tZPQ",
        "arn:aws:iam::992680757326:role/PiyoPiyoDev-KnowledgeAPIRole4717F15A-gLS6qevDv0Yx",
        "arn:aws:iam::992680757326:role/PiyoPiyoDev-KnowledgeWorkerRole6EA081DE-WIIdqSVtjRrC",
        "arn:aws:iam::992680757326:role/PiyoPiyoDev-KnowledgePDFRole5CE8A860-5d5r40MlY28i"
      ]
    },
    {
      "Sid": "ReadExistingApiEndpoint",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET"
      ],
      "Resource": "arn:aws:apigateway:us-east-1::/apis/xk4vd8adrd"
    },
    {
      "Sid": "ReadExistingModelProfileAttributes",
      "Effect": "Allow",
      "Action": [
        "bedrock:GetInferenceProfile",
        "bedrock:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:bedrock:us-east-1:992680757326:application-inference-profile/yfevvxi4bbi9",
        "arn:aws:bedrock:us-east-1:992680757326:application-inference-profile/7z9pcwixgslg"
      ]
    }
  ]
}
